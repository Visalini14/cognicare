# Firebase Web App Configuration
# Copy this file to '.env' and fill in your Firebase project credentials.
# If these variables are left empty, CogniCare automatically runs in Demo Mode (using LocalStorage Data Management).

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Google Cloud Text-to-Speech API Key (for Neural Wavenet Indian Voices)
VITE_GOOGLE_TTS_API_KEY=your_google_cloud_tts_api_key_here

# Government of India Bhashini API (AI4Bharat IndicTTS for 22 Indian Languages)
VITE_BHASHINI_API_KEY=your_bhashini_api_key_here
VITE_BHASHINI_USER_ID=your_bhashini_user_id_here
